@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Password Reset Sent";
}

<div class="auth-wrapper">
    <div class="auth-card text-center">
        
        <div class="rcss-brand-icon mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.3rem;">
            <i class="bi bi-envelope-check"></i>
        </div>
        <h3 class="fw-bold text-slate-900 tracking-tight auth-header-title mb-2">Check Your Email</h3>
        <p class="text-slate-600 small mb-4">
            If an account exists with that address, instructions to reset your password have been dispatched.
        </p>

        <a asp-page="./Login" class="btn btn-primary w-100 py-2.5 fw-semibold shadow-sm">
            <i class="bi bi-arrow-left me-1.5"></i>Return to Sign In
        </a>

    </div>
</div>
