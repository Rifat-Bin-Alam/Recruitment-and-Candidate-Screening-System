@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-wrapper">
    <div class="auth-card">
        
        <div class="text-center mb-3 mb-md-4">
            <div class="rcss-brand-icon mx-auto mb-2" style="width: 42px; height: 42px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M0 8a4 4 0 0 1 7.465-2H14a.5.5 0 0 1 .354.146l1.5 1.5a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0L13 9.207l-.646.647a.5.5 0 0 1-.708 0L11 9.207l-.646.647a.5.5 0 0 1-.708 0L9 9.207l-.646.647A.5.5 0 0 1 7.646 9.5 4.002 4.002 0 0 1 0 8m4-1a1 1 0 1 0 0 2 1 1 0 0 0 0-2"/>
                </svg>
            </div>
            <h3 class="fw-bold text-slate-900 tracking-tight auth-header-title mb-1">Reset Password</h3>
            <p class="text-slate-500 small auth-header-subtitle mb-0">Enter your registered email to receive recovery instructions</p>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2.5 mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">
                    Email Address <span class="required-dot">*</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 py-md-2.5 fw-semibold shadow-sm mb-3">
                <i class="bi bi-send me-1.5"></i>Send Password Reset Link
            </button>
        </form>

        <div class="text-center pt-2.5 border-top small text-slate-600">
            Remembered your password? 
            <a asp-page="./Login" class="text-primary fw-semibold text-decoration-none">
                Back to Sign In
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
