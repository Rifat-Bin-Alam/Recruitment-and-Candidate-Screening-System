@page
@model LoginModel

@{
    ViewData["Title"] = "Account Sign In";
}

<div class="auth-wrapper">
    <div class="auth-card">
        
        <!-- Header -->
        <div class="text-center mb-3 mb-md-4">
            <div class="rcss-brand-icon mx-auto mb-2" style="width: 42px; height: 42px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2M5 8h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1"/>
                </svg>
            </div>
            <h3 class="fw-bold text-slate-900 tracking-tight auth-header-title mb-1">Welcome to TalentScreen</h3>
            <p class="text-slate-600 small auth-header-subtitle mb-0">Sign in to your Candidate or Staff portal account</p>
        </div>

        <!-- Live feedback for autofill actions -->
        <div id="demo-autofill-feedback" class="d-none"></div>

        <form id="account" method="post">
            
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2.5 mb-3" role="alert"></div>
            }

            <!-- Email Input -->
            <div class="mb-2.5 mb-md-3">
                <label asp-for="Input.Email" class="form-label">
                    Email Address <span class="required-dot">*</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block" role="alert"></span>
            </div>

            <!-- Password Input -->
            <div class="mb-2.5 mb-md-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="Input.Password" class="form-label mb-0">
                        Password <span class="required-dot">*</span>
                    </label>
                    <a id="forgot-password" asp-page="./ForgotPassword" class="small text-primary text-decoration-none">
                        Forgot password?
                    </a>
                </div>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-key"></i></span>
                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="current-password"
                           aria-required="true"
                           placeholder="Enter your password" />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block" role="alert"></span>
            </div>

            <!-- Remember Me -->
            <div class="form-check mb-3 mb-md-3.5">
                <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMeCheck" />
                <label class="form-check-label text-slate-700 small" for="rememberMeCheck">
                    Keep me signed in on this device
                </label>
            </div>

            <!-- Submit Button -->
            <button id="login-submit" type="submit" class="btn btn-primary w-100 py-2 py-md-2.5 fw-semibold shadow-sm mb-3">
                <i class="bi bi-box-arrow-in-right me-1.5"></i>Sign In to Portal
            </button>
            
        </form>

        <!-- Quick Demo Credentials Autofill Panel -->
        <div class="pt-3 border-top">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-slate-800 small fw-bold text-uppercase tracking-wider" style="font-size: 0.72rem; letter-spacing: 0.04em;">
                    <i class="bi bi-magic me-1 text-primary"></i>Demo Credential Autofill
                </span>
                <button type="button"
                        id="btn-one-click-demo"
                        class="btn-demo-pill"
                        title="Click to quick-autofill HR Demo Credentials"
                        aria-label="One-click autofill demo credentials">
                    <i class="bi bi-lightning-charge-fill text-warning me-1"></i>One-Click Demo
                </button>
            </div>

            <div class="d-flex flex-column gap-2 mb-3">
                <!-- HR Demo Autofill Button -->
                <button type="button"
                        id="btn-autofill-hr"
                        class="btn btn-outline-primary btn-demo-autofill w-100 text-start d-flex justify-content-between align-items-center">
                    <span>
                        <i class="bi bi-shield-lock me-1.5 text-primary"></i>
                        Fill HR Demo Credentials
                    </span>
                    <span class="status-pill status-pill-info" style="font-size: 0.65rem; padding: 1px 6px;">HR Manager</span>
                </button>

                <!-- Candidate Demo Autofill Button -->
                <button type="button"
                        id="btn-autofill-candidate"
                        class="btn btn-outline-success btn-demo-autofill w-100 text-start d-flex justify-content-between align-items-center">
                    <span>
                        <i class="bi bi-person-check me-1.5 text-success"></i>
                        Fill Candidate Demo Credentials
                    </span>
                    <span class="status-pill status-pill-success" style="font-size: 0.65rem; padding: 1px 6px;">Candidate</span>
                </button>
            </div>

            <div class="demo-autofill-hint p-2 rounded small text-center">
                <i class="bi bi-info-circle me-1 text-primary"></i>Clicking autofill populates credentials safely without auto-submitting.
            </div>
        </div>

        <!-- Footer Link -->
        <div class="text-center mt-3 pt-2.5 border-top small text-slate-700">
            <span class="d-inline-block">Don't have a candidate account yet?</span>
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary fw-semibold text-decoration-none text-nowrap ms-1">
                Register as Candidate&nbsp;&rarr;
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
