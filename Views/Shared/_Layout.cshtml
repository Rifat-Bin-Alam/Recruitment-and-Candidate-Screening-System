@using Microsoft.AspNetCore.Identity
@using RecruitmentAndCandidateScreeningSystem.Models
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Recruitment & Candidate Screening System</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Custom RCSS Favicon -->
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="alternate icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

<header>
    <nav class="navbar navbar-expand-lg navbar-dark rcss-navbar">
        <div class="container-fluid px-lg-4">

            <!-- Brand -->
            <a class="rcss-brand"
               asp-controller="Home"
               asp-action="Index">
                <span class="rcss-brand-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M6.5 1A1.5 1.5 0 0 0 5 2.5V3H1.5A1.5 1.5 0 0 0 0 4.5v8A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-8A1.5 1.5 0 0 0 14.5 3H11v-.5A1.5 1.5 0 0 0 9.5 1zm0 1h3a.5.5 0 0 1 .5.5V3H6v-.5a.5.5 0 0 1 .5-.5m1.886 6.914L15 7.151V12.5a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5V7.15l6.614 1.764a1.5 1.5 0 0 0 .772 0M1.5 4h13a.5.5 0 0 1 .5.5v1.616L8.129 7.948a.5.5 0 0 1-.258 0L1 6.116V4.5a.5.5 0 0 1 .5-.5"/>
                    </svg>
                </span>
                <span>TalentScreen</span>
                @if (SignInManager.IsSignedIn(User))
                {
                    @if (User.IsInRole(RoleNames.HRManager))
                    {
                        <span class="rcss-portal-badge hr">HR Portal</span>
                    }
                    else if (User.IsInRole(RoleNames.Candidate))
                    {
                        <span class="rcss-portal-badge">Candidate</span>
                    }
                }
            </a>

            <!-- Mobile Toggler -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navigation Links -->
            <div class="collapse navbar-collapse"
                 id="mainNavbar">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">

                    @if (SignInManager.IsSignedIn(User))
                    {
                        @if (User.IsInRole(RoleNames.Candidate))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Candidate"
                                   asp-action="Dashboard">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="CandidateJobs"
                                   asp-action="Index">
                                    Jobs
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="CandidateJobs"
                                   asp-action="MyApplications">
                                    My Applications
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="CandidateOffers"
                                   asp-action="Index">
                                    Offers
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="CandidateProfiles"
                                   asp-action="Index">
                                    Profile
                                </a>
                            </li>
                        }

                        @if (User.IsInRole(RoleNames.HRManager))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="HRDashboard"
                                   asp-action="Index">
                                    Overview
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="JobCirculars"
                                   asp-action="Index">
                                    Job Circulars
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="HRApplications"
                                   asp-action="Index">
                                    Applications
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Offers"
                                   asp-action="Index">
                                    Offers
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="HRReports"
                                   asp-action="Index">
                                    Reports
                                </a>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="CandidateJobs"
                               asp-action="Index">
                                Browse Jobs
                            </a>
                        </li>
                    }

                </ul>
                <div class="d-lg-none border-mobile-divider"></div>
                <!-- Auth Controls -->
                <partial name="_LoginPartial" />

            </div>

        </div>
    </nav>
</header>

<!-- Main Body -->
<main role="main">
    @RenderBody()
</main>

<!-- Footer -->
<footer class="rcss-footer">
    <div class="container-fluid px-lg-4">
        <!-- Row 1: Existing footer content -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 text-center text-md-start py-2">
            <div>
                &copy; 2026 <strong>TalentScreen</strong> &mdash; Developed by <strong>Rifat Bin Alam</strong>. All rights reserved.
            </div>
            <div class="d-flex align-items-center justify-content-center gap-3 small flex-wrap">
                <a href="mailto:rifat5566123@gmail.com" class="text-secondary text-decoration-none d-inline-flex align-items-center gap-1">
                    <i class="bi bi-envelope"></i> rifat5566123@gmail.com
                </a>
                <span class="text-secondary d-none d-sm-inline">&bull;</span>
                <a href="https://github.com/Rifat-Bin-Alam" target="_blank" rel="noopener noreferrer" class="text-secondary text-decoration-none d-inline-flex align-items-center gap-1">
                    <i class="bi bi-github"></i> GitHub
                </a>
                <span class="text-secondary d-none d-sm-inline">&bull;</span>
                <a asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none">Privacy Policy</a>
            </div>
        </div>

        <!-- Subtle horizontal divider -->
        <hr class="rcss-footer-divider my-1" />

        <!-- Row 2: Team Mild Bots Credit -->
        <div class="text-center py-1.5 small rcss-footer-team">
            <strong>Team Mild Bots</strong> &mdash; Rifat Bin Alam, Farhana Karim Labonno, Tahsin Akter Roza, Farhana Ahamed Shethe
        </div>
    </div>
</footer>

<!-- Scripts -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

<!-- Sticky Go to Top Button -->
<button type="button"
        id="rcssBackToTop"
        class="rcss-back-to-top"
        aria-label="Back to top"
        title="Back to top">
    <i class="bi bi-chevron-up"></i>
</button>

</body>
</html>
