@using Microsoft.AspNetCore.Identity
@using RecruitmentAndCandidateScreeningSystem.Models
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Recruitment System</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/RecruitmentAndCandidateScreeningSystem.styles.css"
          asp-append-version="true" />
</head>

<body>

<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">

        <div class="container">

            <a class="navbar-brand fw-bold"
               asp-controller="Home"
               asp-action="Index">
                Recruitment System
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    @if (SignInManager.IsSignedIn(User))
                    {
                        @if (User.IsInRole(RoleNames.Candidate))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Candidate"
                                   asp-action="Dashboard">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="CandidateJobs"
                                   asp-action="Index">
                                    Jobs
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="CandidateJobs"
                                   asp-action="MyApplications">
                                    My Applications
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="CandidateProfiles"
                                   asp-action="Index">
                                    Profile
                                </a>
                            </li>
                        }

                        @if (User.IsInRole(RoleNames.HRManager))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="JobCirculars"
                                   asp-action="Index">
                                    Job Circulars
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="HRApplications"
                                   asp-action="Index">
                                    Applications
                                </a>
                            </li>
                        }
                    }

                </ul>

                <partial name="_LoginPartial" />

            </div>

        </div>

    </nav>
</header>

<div class="container mt-4">

    <main role="main" class="pb-4">
        @RenderBody()
    </main>

</div>

<footer class="border-top footer text-muted mt-5">

    <div class="container py-3">
        &copy; 2026 - Recruitment and Candidate Screening System
    </div>

</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>