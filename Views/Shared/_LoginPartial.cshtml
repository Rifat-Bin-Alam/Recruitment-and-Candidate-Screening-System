@using Microsoft.AspNetCore.Identity
@using RecruitmentAndCandidateScreeningSystem.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-lg-center gap-1">

    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            @if (User.IsInRole(RoleNames.Candidate))
            {
                <a class="rcss-user-pill"
                   asp-controller="CandidateProfiles"
                   asp-action="Index"
                   title="Manage Candidate Profile">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
                    </svg>
                    <span>@User.Identity?.Name</span>
                </a>
            }
            else if (User.IsInRole(RoleNames.HRManager))
            {
                <a class="rcss-user-pill"
                   asp-controller="HRDashboard"
                   asp-action="Index"
                   title="HR Management">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
                    </svg>
                    <span>@User.Identity?.Name</span>
                </a>
            }
            else
            {
                <span class="rcss-user-pill">
                    @User.Identity?.Name
                </span>
            }
        </li>

        <li class="nav-item">
            <form class="d-block w-100 mt-1 mt-lg-0"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                  method="post">
                <button type="submit"
                        class="rcss-logout-btn btn-sm">
                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-page="/Account/Register">
                <i class="bi bi-person-plus me-1 d-lg-none"></i>Register
            </a>
        </li>

        <li class="nav-item ms-lg-1 mt-1 mt-lg-0">
            <a class="btn btn-sm btn-primary px-3 w-100 w-lg-auto"
               asp-area="Identity"
               asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
            </a>
        </li>
    }

</ul>