@using Microsoft.AspNetCore.Identity
@using RecruitmentAndCandidateScreeningSystem.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">

    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">

            @if (User.IsInRole(RoleNames.Candidate))
            {
                <a class="nav-link text-dark"
                   asp-controller="Candidate"
                   asp-action="Dashboard">
                    Hello @User.Identity?.Name!
                </a>
            }
            else if (User.IsInRole(RoleNames.HRManager))
            {
                <a class="nav-link text-dark"
                   asp-controller="HRDashboard"
                   asp-action="Index">
                    Hello @User.Identity?.Name!
                </a>
            }

        </li>

        <li class="nav-item">
            <form class="form-inline"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                  method="post">

                <button type="submit"
                        class="nav-link btn btn-link text-dark">
                    Logout
                </button>

            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-area="Identity"
               asp-page="/Account/Register">
                Register
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-area="Identity"
               asp-page="/Account/Login">
                Login
            </a>
        </li>
    }

</ul>