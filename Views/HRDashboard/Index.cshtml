@model RecruitmentAndCandidateScreeningSystem.ViewModels.HRDashboardViewModel

@{
    ViewData["Title"] = "HR Dashboard";
}

<div class="container">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-bold">HR Dashboard</h2>

        <p class="text-muted mb-0">
            Recruitment overview and candidate screening summary.
        </p>
    </div>


    <!-- Summary Cards -->
    <div class="row g-4 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted">
                        Total Applications
                    </div>

                    <div class="display-6 fw-bold">
                        @Model.TotalApplications
                    </div>
                </div>
            </div>
        </div>


        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted">
                        AI Evaluated
                    </div>

                    <div class="display-6 fw-bold">
                        @Model.AIEvaluated
                    </div>
                </div>
            </div>
        </div>


        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted">
                        Shortlisted
                    </div>

                    <div class="display-6 fw-bold text-success">
                        @Model.Shortlisted
                    </div>
                </div>
            </div>
        </div>


        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted">
                        Manual Review
                    </div>

                    <div class="display-6 fw-bold text-warning">
                        @Model.ManualReview
                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- Second Row -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted">
                        Rejected
                    </div>

                    <div class="display-6 fw-bold text-danger">
                        @Model.Rejected
                    </div>
                </div>
            </div>
        </div>


        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted">
                        Payment Pending
                    </div>

                    <div class="display-6 fw-bold">
                        @Model.PaymentPending
                    </div>
                </div>
            </div>
        </div>


        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted">
                        Published Jobs
                    </div>

                    <div class="display-6 fw-bold">
                        @Model.PublishedJobs
                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- Recruitment Funnel -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                Recruitment Funnel
            </h5>
        </div>

        <div class="card-body">

            <div class="row text-center g-3">

                <div class="col-md-4">
                    <div class="border rounded p-4">
                        <div class="text-muted">
                            Applications
                        </div>

                        <div class="display-6 fw-bold">
                            @Model.TotalApplications
                        </div>
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="border rounded p-4">
                        <div class="text-muted">
                            AI Evaluated
                        </div>

                        <div class="display-6 fw-bold">
                            @Model.AIEvaluated
                        </div>
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="border rounded p-4">
                        <div class="text-muted">
                            Shortlisted
                        </div>

                        <div class="display-6 fw-bold text-success">
                            @Model.Shortlisted
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- Recent Applications -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                Recent Applications
            </h5>

            <a asp-controller="HRApplications"
               asp-action="Index"
               class="btn btn-sm btn-outline-primary">
                View All
            </a>
        </div>

        <div class="card-body p-0">

            @if (Model.RecentApplications.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Reference</th>
                                <th>Candidate</th>
                                <th>Job</th>
                                <th>Applied</th>
                                <th>Status</th>
                                <th>AI Score</th>
                                <th>AI Decision</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var application in Model.RecentApplications)
                            {
                                <tr>

                                    <td>
                                        <span class="fw-semibold">
                                            @application.ApplicationReferenceId
                                        </span>
                                    </td>

                                    <td>
                                        @application.CandidateName
                                    </td>

                                    <td>
                                        @application.JobTitle
                                    </td>

                                    <td>
                                        @application.AppliedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @if (application.ApplicationStatus == "Shortlisted")
                                        {
                                            <span class="badge bg-success">
                                                Shortlisted
                                            </span>
                                        }
                                        else if (application.ApplicationStatus == "ManualReview")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Manual Review
                                            </span>
                                        }
                                        else if (application.ApplicationStatus == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @application.ApplicationStatus
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (application.AIMatchingScore.HasValue)
                                        {
                                            <span class="fw-semibold">
                                                @application.AIMatchingScore.Value.ToString("0.##")%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not evaluated
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (application.AIDecision == "SHORTLISTED")
                                        {
                                            <span class="badge bg-success">
                                                SHORTLISTED
                                            </span>
                                        }
                                        else if (application.AIDecision == "MANUAL REVIEW")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                MANUAL REVIEW
                                            </span>
                                        }
                                        else if (application.AIDecision == "REJECTED")
                                        {
                                            <span class="badge bg-danger">
                                                REJECTED
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not evaluated
                                            </span>
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    No applications have been submitted yet.
                </div>
            }

        </div>

    </div>


    <!-- Quick Actions -->
    <div class="card shadow-sm border-0 mb-5">

        <div class="card-header">
            <h5 class="mb-0">
                Quick Actions
            </h5>
        </div>

        <div class="card-body">

            <div class="d-flex flex-wrap gap-2">

                <a asp-controller="JobCirculars"
                   asp-action="Index"
                   class="btn btn-primary">
                    Manage Job Circulars
                </a>

                <a asp-controller="HRApplications"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    Review Applications
                </a>

            </div>

        </div>

    </div>

</div>