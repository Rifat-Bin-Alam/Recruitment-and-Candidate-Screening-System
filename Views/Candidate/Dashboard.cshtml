@model RecruitmentAndCandidateScreeningSystem.ViewModels.CandidateDashboardViewModel

@{
    ViewData["Title"] = "Candidate Dashboard";
}

<div class="container">

    <div class="mb-4">
        <h2 class="fw-bold">
            Welcome, @Model.ProfileName 👋
        </h2>

        <p class="text-muted">
            Manage your profile, documents and job applications.
        </p>
    </div>

    @if (!Model.HasProfile)
    {
        <div class="alert alert-warning">
            <strong>Your profile is incomplete.</strong>
            Please complete your candidate profile before applying for jobs.

            <a asp-controller="CandidateProfiles"
               asp-action="Index"
               class="alert-link">
                Complete Profile
            </a>
        </div>
    }

    <div class="row g-4">

        <!-- PROFILE -->

        <div class="col-md-4">
            <div class="card dashboard-card h-100 shadow-sm border-0">
                <div class="card-body">

                    <h6 class="text-muted">
                        Candidate Profile
                    </h6>

                    <h3 class="fw-bold">
                        @(Model.HasProfile ? "Completed" : "Incomplete")
                    </h3>

                    <a asp-controller="CandidateProfiles"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Manage Profile
                    </a>

                </div>
            </div>
        </div>


        <!-- DOCUMENTS -->

        <div class="col-md-4">
            <div class="card dashboard-card h-100 shadow-sm border-0">
                <div class="card-body">

                    <h6 class="text-muted">
                        Documents
                    </h6>

                    <div class="mt-3">

                        <div class="d-flex justify-content-between mb-2">
                            <span>Profile Photo</span>

                            @if (Model.HasPhoto)
                            {
                                <span class="text-success fw-semibold">
                                    ✓ Uploaded
                                </span>
                            }
                            else
                            {
                                <span class="text-danger">
                                    Not Uploaded
                                </span>
                            }
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Signature</span>

                            @if (Model.HasSignature)
                            {
                                <span class="text-success fw-semibold">
                                    ✓ Uploaded
                                </span>
                            }
                            else
                            {
                                <span class="text-danger">
                                    Not Uploaded
                                </span>
                            }
                        </div>

                        <div class="d-flex justify-content-between">
                            <span>Current CV</span>

                            @if (Model.HasCurrentCV)
                            {
                                <span class="text-success fw-semibold">
                                    ✓ Uploaded
                                </span>
                            }
                            else
                            {
                                <span class="text-danger">
                                    Not Uploaded
                                </span>
                            }
                        </div>

                    </div>

                    <div class="mt-3">
                        <small class="text-muted">
                            Total CVs: @Model.CVCount
                        </small>
                    </div>

                    <a asp-controller="CandidateProfiles"
                       asp-action="Index"
                       class="btn btn-outline-primary mt-3">
                        Manage Documents
                    </a>

                </div>
            </div>
        </div>


        <!-- APPLICATIONS -->

        <div class="col-md-4">
            <div class="card dashboard-card h-100 shadow-sm border-0">
                <div class="card-body">

                    <h6 class="text-muted">
                        Job Applications
                    </h6>

                    <h3 class="fw-bold">
                        @Model.ApplicationCount
                    </h3>

                    <p class="text-muted">
                        Total applications submitted.
                    </p>

                    <a asp-controller="CandidateJobs"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Browse Jobs
                    </a>

                </div>
            </div>
        </div>

    </div>

</div>