@model RecruitmentAndCandidateScreeningSystem.ViewModels.CandidateDashboardViewModel

@{
    ViewData["Title"] = "Candidate Dashboard";
}

<div class="container py-4">

    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <div class="d-inline-flex align-items-center gap-2 mb-1">
                <span class="status-pill status-pill-info">Candidate Portal</span>
                <span class="text-slate-500 small">&bull; Welcome back</span>
            </div>
            <h2 class="fw-bold text-slate-900 tracking-tight mb-1">@Model.ProfileName</h2>
            <p class="text-slate-500 small mb-0">Monitor your recruitment applications, credentials dossier, and employment offers.</p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="CandidateJobs"
               asp-action="Index"
               class="btn btn-primary btn-sm px-3 shadow-sm">
                <i class="bi bi-briefcase me-1"></i>Explore Open Positions
            </a>
            <a asp-controller="CandidateProfiles"
               asp-action="Index"
               class="btn btn-outline-secondary btn-sm px-3">
                <i class="bi bi-pencil me-1"></i>Manage Dossier
            </a>
        </div>
    </div>

    <!-- Incomplete Profile Notice -->
    @if (!Model.HasProfile)
    {
        <div class="alert alert-warning border-warning-subtle bg-warning-subtle d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 p-3 mb-4 rounded-3 shadow-xs">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box icon-box-warning flex-shrink-0" style="width: 36px; height: 36px;">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">Profile Completion Required</h6>
                    <p class="text-slate-700 small mb-0">Please fill out your personal credentials, education, and upload your CV before applying for positions.</p>
                </div>
            </div>
            <a asp-controller="CandidateProfiles" asp-action="Index" class="btn btn-warning btn-sm text-nowrap fw-semibold">
                Complete Profile Now &rarr;
            </a>
        </div>
    }

    <!-- KPI / Overview Cards -->
    <div class="row g-4 mb-4">

        <!-- Card 1: Profile Status -->
        <div class="col-lg-4">
            <div class="card h-100 border shadow-sm">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="icon-box icon-box-primary">
                            <i class="bi bi-person-badge fs-5"></i>
                        </div>
                        @if (Model.HasProfile)
                        {
                            <span class="status-pill status-pill-success">
                                <span class="status-dot"></span>Dossier Active
                            </span>
                        }
                        else
                        {
                            <span class="status-pill status-pill-warning">
                                <span class="status-dot"></span>Incomplete
                            </span>
                        }
                    </div>

                    <h5 class="fw-bold text-slate-900 mb-1">Candidate Profile</h5>
                    <p class="text-slate-600 small mb-3">
                        Central academic history, contact records, residential details, and technical competencies.
                    </p>

                    <div class="mt-auto pt-3 border-top">
                        <a asp-controller="CandidateProfiles" asp-action="Index" class="btn btn-outline-primary btn-sm w-100">
                            <i class="bi bi-pencil-square me-1"></i>Update Profile Details
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Document Vault -->
        <div class="col-lg-4">
            <div class="card h-100 border shadow-sm">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="icon-box icon-box-success">
                            <i class="bi bi-shield-check fs-5"></i>
                        </div>
                        <span class="badge bg-light text-slate-700 border">@Model.CVCount Stored Document(s)</span>
                    </div>

                    <h5 class="fw-bold text-slate-900 mb-1">Document Vault</h5>
                    <p class="text-slate-600 small mb-2">Verified candidate verification assets:</p>

                    <div class="d-flex flex-column gap-2 mb-3 small">
                        <div class="d-flex justify-content-between align-items-center p-2 rounded bg-light border">
                            <span class="text-slate-700">Identity Photo (Max 500 KB)</span>
                            @if (Model.HasPhoto)
                            {
                                <span class="status-pill status-pill-success" style="font-size: 0.72rem; padding: 2px 6px;">
                                    <span class="status-dot"></span>Uploaded
                                </span>
                            }
                            else
                            {
                                <span class="status-pill status-pill-danger" style="font-size: 0.72rem; padding: 2px 6px;">
                                    <span class="status-dot"></span>Missing
                                </span>
                            }
                        </div>
                        <div class="d-flex justify-content-between align-items-center p-2 rounded bg-light border">
                            <span class="text-slate-700">Official Signature (Max 500 KB)</span>
                            @if (Model.HasSignature)
                            {
                                <span class="status-pill status-pill-success" style="font-size: 0.72rem; padding: 2px 6px;">
                                    <span class="status-dot"></span>Uploaded
                                </span>
                            }
                            else
                            {
                                <span class="status-pill status-pill-danger" style="font-size: 0.72rem; padding: 2px 6px;">
                                    <span class="status-dot"></span>Missing
                                </span>
                            }
                        </div>
                        <div class="d-flex justify-content-between align-items-center p-2 rounded bg-light border">
                            <span class="text-slate-700">Current CV (Max 4 MB)</span>
                            @if (Model.HasCurrentCV)
                            {
                                <span class="status-pill status-pill-success" style="font-size: 0.72rem; padding: 2px 6px;">
                                    <span class="status-dot"></span>Active CV
                                </span>
                            }
                            else
                            {
                                <span class="status-pill status-pill-warning" style="font-size: 0.72rem; padding: 2px 6px;">
                                    <span class="status-dot"></span>Missing
                                </span>
                            }
                        </div>
                    </div>

                    <div class="mt-auto pt-3 border-top">
                        <a asp-controller="CandidateProfiles" asp-action="Index" class="btn btn-outline-primary btn-sm w-100">
                            <i class="bi bi-file-earmark-arrow-up me-1"></i>Manage Document Vault
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Applications -->
        <div class="col-lg-4">
            <div class="card h-100 border shadow-sm">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="icon-box icon-box-neutral">
                            <i class="bi bi-send fs-5"></i>
                        </div>
                        <span class="status-pill status-pill-info">Lifecycle Tracking</span>
                    </div>

                    <h5 class="fw-bold text-slate-900 mb-1">My Applications</h5>
                    <div class="display-6 fw-bold text-slate-900 mb-1">@Model.ApplicationCount</div>
                    <p class="text-slate-600 small mb-3">
                        Total job positions submitted through the recruitment platform.
                    </p>

                    <div class="mt-auto pt-3 border-top d-flex gap-2">
                        <a asp-controller="CandidateJobs" asp-action="MyApplications" class="btn btn-outline-primary btn-sm flex-grow-1">
                            <i class="bi bi-clock-history me-1"></i>Track Status
                        </a>
                        <a asp-controller="CandidateOffers" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-award me-1"></i>Offers
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Quick Action Banner -->
    <div class="card border shadow-sm bg-white p-3 p-md-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h6 class="fw-bold text-slate-900 mb-1">Looking for employment offers?</h6>
                <p class="text-slate-600 small mb-0">Check if HR has issued formal offers, proposed joining dates, or response deadlines.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="CandidateOffers" asp-action="Index" class="btn btn-outline-dark btn-sm">
                    <i class="bi bi-envelope-paper me-1"></i>View Offers
                </a>
                <a asp-controller="CandidateJobs" asp-action="Index" class="btn btn-primary btn-sm shadow-sm">
                    <i class="bi bi-search me-1"></i>Browse All Positions
                </a>
            </div>
        </div>
    </div>

</div>