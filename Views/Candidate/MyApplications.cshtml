@model IEnumerable<RecruitmentAndCandidateScreeningSystem.ViewModels.CandidateApplicationViewModel>

@{
    ViewData["Title"] = "My Applications";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">My Applications</h2>
            <p class="text-muted mb-0">
                Track your applications, payment status, and submitted CV.
            </p>
        </div>

        <a asp-controller="CandidateJobs"
           asp-action="Index"
           class="btn btn-primary">
            Browse Jobs
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-light border">
            You have not applied for any jobs yet.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var application in Model)
            {
                <div class="col-12">

                    <div class="card border-0 shadow-sm">

                        <div class="card-body">

                            <div class="row g-4">

                                <!-- JOB INFORMATION -->
                                <div class="col-md-4">

                                    <h5 class="fw-bold mb-1">
                                        @application.JobTitle
                                    </h5>

                                    <small class="text-muted d-block mb-3">
                                        Applied:
                                        @application.AppliedAt.ToLocalTime()
                                    </small>

                                    @if (!string.IsNullOrWhiteSpace(
                                        application.ApplicationReferenceId))
                                    {
                                        <div class="small">
                                            <span class="text-muted">
                                                Application Reference:
                                            </span>

                                            <div class="fw-semibold">
                                                @application.ApplicationReferenceId
                                            </div>
                                        </div>
                                    }

                                </div>


                                <!-- APPLICATION STATUS -->
                                <div class="col-md-2">

                                    <small class="text-muted d-block">
                                        Application Status
                                    </small>

                                    <strong>
                                        @application.ApplicationStatus
                                    </strong>

                                </div>


                                <!-- PAYMENT -->
                                <div class="col-md-3">

                                    <small class="text-muted d-block mb-1">
                                        Payment
                                    </small>

                                    @if (application.PaymentStatus == "Paid")
                                    {
                                        <span class="badge bg-success">
                                            Paid ✓
                                        </span>
                                    }
                                    else if (application.PaymentStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Not Required
                                        </span>
                                    }

                                    @if (application.PaymentAmount.HasValue)
                                    {
                                        <div class="small mt-1">
                                            Amount:
                                            @application.PaymentAmount.Value
                                            .ToString("0.00")
                                        </div>
                                    }

                                </div>


                                <!-- CV -->
                                <div class="col-md-3">

                                    <small class="text-muted d-block mb-1">
                                        CV Submitted
                                    </small>

                                    @if (!string.IsNullOrWhiteSpace(
                                        application.CVFileName))
                                    {
                                        <div class="small fw-semibold text-truncate"
                                             title="@application.CVFileName">
                                            @application.CVFileName
                                        </div>

                                        <a asp-controller="CandidateJobs"
                                           asp-action="DownloadCV"
                                           asp-route-id="@application.CVId"
                                           class="btn btn-outline-primary btn-sm mt-2">
                                            View CV
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            CV not available
                                        </span>
                                    }

                                </div>

                            </div>


                            <!-- ACTIONS -->
                            <hr class="my-4" />

                            <div class="d-flex justify-content-between align-items-center">

                                <div>

                                    @if (application.CanPay)
                                    {
                                        <span class="text-warning fw-semibold">
                                            Payment required to complete application.
                                        </span>
                                    }
                                    else if (application.PaymentStatus == "Paid")
                                    {
                                        <span class="text-success fw-semibold">
                                            Application submitted ✓
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Application submitted.
                                        </span>
                                    }

                                </div>


                                <div>

                                    @if (application.CanPay)
                                    {
                                        <a asp-controller="CandidateJobs"
                                           asp-action="PayNow"
                                           asp-route-id="@application.Id"
                                           class="btn btn-warning">
                                            Pay Now
                                        </a>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>