@model RecruitmentAndCandidateScreeningSystem.Models.JobApplication

@{
    ViewData["Title"] = "Payment Cancelled";
    var jobTitle = Model.JobCircular?.JobTitle ?? Model.JobCircular?.Title ?? "Job Position";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="card border shadow-sm p-4 p-md-5 bg-white text-center">
                
                <div class="rcss-icon-box bg-warning-subtle text-warning-emphasis mx-auto mb-3" style="width: 56px; height: 56px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                        <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z"/>
                    </svg>
                </div>

                <span class="badge text-bg-warning px-3 py-1 mb-2">Checkout Session Closed</span>
                <h3 class="fw-bold text-dark mb-2">Payment Session Cancelled</h3>
                <p class="text-secondary small mb-4">
                    The payment transaction was cancelled. Your application record remains in <strong>Pending</strong> status until payment is confirmed.
                </p>

                <div class="card border bg-light-subtle text-start p-3 p-md-4 mb-4">
                    <dl class="row mb-0 g-2 small">
                        <dt class="col-sm-5 text-muted">Position:</dt>
                        <dd class="col-sm-7 fw-semibold text-dark">@jobTitle</dd>

                        <dt class="col-sm-5 text-muted">Application Ref:</dt>
                        <dd class="col-sm-7">
                            <code class="text-primary fw-semibold">@Model.ApplicationReferenceId</code>
                        </dd>

                        <dt class="col-sm-5 text-muted">Payment Status:</dt>
                        <dd class="col-sm-7">
                            <span class="badge bg-warning text-dark">Payment Pending</span>
                        </dd>
                    </dl>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="CandidateJobs"
                       asp-action="Details"
                       asp-route-id="@Model.JobCircularId"
                       class="btn btn-primary px-4">
                        Return to Position
                    </a>
                    <a asp-controller="CandidateJobs"
                       asp-action="MyApplications"
                       class="btn btn-outline-secondary px-3">
                        My Applications
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>