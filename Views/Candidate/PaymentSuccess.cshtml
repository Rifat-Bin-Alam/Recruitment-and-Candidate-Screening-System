@model RecruitmentAndCandidateScreeningSystem.Models.JobApplication

@{
    ViewData["Title"] = "Payment Confirmation";
    var jobTitle = Model.JobCircular?.JobTitle ?? Model.JobCircular?.Title ?? "Job Position";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="card border shadow-sm p-4 p-md-5 bg-white text-center">
                
                <div class="rcss-icon-box bg-success-subtle text-success mx-auto mb-3" style="width: 56px; height: 56px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                    </svg>
                </div>

                <span class="badge badge-status-success px-3 py-1 mb-2">Verified Transaction</span>
                <h3 class="fw-bold text-dark mb-2">Payment Successfully Verified</h3>
                <p class="text-secondary small mb-4">
                    Your application fee has been processed and your application is now fully registered for recruitment screening.
                </p>

                <div class="card border bg-light-subtle text-start p-3 p-md-4 mb-4">
                    <dl class="row mb-0 g-2 small">
                        <dt class="col-sm-5 text-muted">Position:</dt>
                        <dd class="col-sm-7 fw-semibold text-dark">@jobTitle</dd>

                        <dt class="col-sm-5 text-muted">Application Ref:</dt>
                        <dd class="col-sm-7">
                            <code class="text-primary fw-semibold">@Model.ApplicationReferenceId</code>
                        </dd>

                        @if (Model.Payment != null)
                        {
                            <dt class="col-sm-5 text-muted">Amount Paid:</dt>
                            <dd class="col-sm-7 fw-semibold text-dark">$@Model.Payment.Amount.ToString("0.00") USD</dd>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Payment?.TransactionId))
                        {
                            <dt class="col-sm-5 text-muted">Transaction ID:</dt>
                            <dd class="col-sm-7 text-secondary">@Model.Payment.TransactionId</dd>
                        }
                    </dl>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="CandidateJobs"
                       asp-action="MyApplications"
                       class="btn btn-primary px-4">
                        View My Applications
                    </a>
                    <a asp-controller="Candidate"
                       asp-action="Dashboard"
                       class="btn btn-outline-secondary px-3">
                        Dashboard
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>