@model IEnumerable<RecruitmentAndCandidateScreeningSystem.Models.JobApplication>

@{
    ViewData["Title"] = "Offers";
}

<div class="container">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Offers</h2>
            <p class="text-muted mb-0">
                Manage offers for shortlisted candidates.
            </p>
        </div>
    </div>


    <!-- Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <!-- Offers Table -->
    <div class="card shadow-sm border-0">

        <div class="card-header">
            <h5 class="mb-0">
                Shortlisted Candidates
            </h5>
        </div>

        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Reference</th>
                                <th>Candidate</th>
                                <th>Job</th>
                                <th>Applied</th>
                                <th>Offer Status</th>
                                <th>Candidate Decision</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var application in Model)
                            {
                                <tr>

                                    <td>
                                        <span class="fw-semibold">
                                            @application.ApplicationReferenceId
                                        </span>
                                    </td>

                                    <td>
                                        @application.CandidateProfile.FullName
                                    </td>

                                    <td>
                                        @application.JobCircular.JobTitle
                                    </td>

                                    <td>
                                        @application.AppliedAt
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @if (application.Offer == null)
                                        {
                                            <span class="badge bg-secondary">
                                                Not Created
                                            </span>
                                        }
                                        else if (application.Offer.Status ==
                                                 RecruitmentAndCandidateScreeningSystem.Models.Enums.OfferStatus.Accepted)
                                        {
                                            <span class="badge bg-success">
                                                Accepted
                                            </span>
                                        }
                                        else if (application.Offer.Status ==
                                                 RecruitmentAndCandidateScreeningSystem.Models.Enums.OfferStatus.Rejected)
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (application.Offer == null)
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                        else if (application.Offer.CandidateDecision ==
                                                 RecruitmentAndCandidateScreeningSystem.Models.Enums.CandidateDecision.Accepted)
                                        {
                                            <span class="badge bg-success">
                                                Accepted
                                            </span>
                                        }
                                        else if (application.Offer.CandidateDecision ==
                                                 RecruitmentAndCandidateScreeningSystem.Models.Enums.CandidateDecision.Rejected)
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (application.Offer == null)
                                        {
                                            <a asp-action="Create"
                                               asp-route-applicationId="@application.Id"
                                               class="btn btn-sm btn-primary">
                                                Create Offer
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Details"
                                               asp-route-id="@application.Offer.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                View Offer
                                            </a>
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    No shortlisted candidates are currently available.
                </div>
            }

        </div>

    </div>

</div>