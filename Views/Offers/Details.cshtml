@model RecruitmentAndCandidateScreeningSystem.Models.Offer

@{
    ViewData["Title"] = "Offer Details";
}

<div class="container py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Offer Details</h2>
            <p class="text-muted mb-0">
                View the offer and joining information for this candidate.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            Back to Offers
        </a>
    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <!-- CANDIDATE INFORMATION -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                Candidate Information
            </h5>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="text-muted">
                        Candidate Name
                    </label>

                    <div class="fw-semibold">
                        @(Model.JobApplication?.CandidateProfile?.FullName ?? "N/A")
                    </div>
                </div>


                <div class="col-md-6 mb-3">
                    <label class="text-muted">
                        Application Reference
                    </label>

                    <div class="fw-semibold">
                        @(Model.JobApplication?.ApplicationReferenceId ?? "N/A")
                    </div>
                </div>


                <div class="col-md-6 mb-3">
                    <label class="text-muted">
                        Job Title
                    </label>

                    <div class="fw-semibold">
                        @(Model.JobApplication?.JobCircular?.JobTitle ?? "N/A")
                    </div>
                </div>


                <div class="col-md-6 mb-3">
                    <label class="text-muted">
                        Application Status
                    </label>

                    <div>
                        <span class="badge bg-success">
                            @(Model.JobApplication?.Status.ToString() ?? "N/A")
                        </span>
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- OFFER INFORMATION -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                Offer Information
            </h5>
        </div>

        <div class="card-body">

            <!-- OFFER DETAILS -->
            <div class="mb-4">

                <label class="text-muted">
                    Offer Details
                </label>

                <div class="border rounded p-3 bg-light">
                    @Model.OfferDetails
                </div>

            </div>


            <div class="row">

                <!-- OFFER DATE -->
                <div class="col-md-4 mb-3">

                    <label class="text-muted">
                        Offer Date
                    </label>

                    <div class="fw-semibold">

                        <span>
                            @Model.OfferDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                        </span>

                    </div>

                </div>


                <!-- RESPONSE DEADLINE -->
                <div class="col-md-4 mb-3">

                    <label class="text-muted">
                        Response Deadline
                    </label>

                    <div class="fw-semibold">

                        @if (Model.ResponseDeadline.HasValue)
                        {
                            <span>
                                @Model.ResponseDeadline.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                No deadline
                            </span>
                        }

                    </div>

                </div>


                <!-- OFFER STATUS -->
                <div class="col-md-4 mb-3">

                    <label class="text-muted">
                        Offer Status
                    </label>

                    <div>

                        @if (Model.Status == RecruitmentAndCandidateScreeningSystem.Models.Enums.OfferStatus.Accepted)
                        {
                            <span class="badge bg-success">
                                Accepted
                            </span>
                        }
                        else if (Model.Status == RecruitmentAndCandidateScreeningSystem.Models.Enums.OfferStatus.Rejected)
                        {
                            <span class="badge bg-danger">
                                Rejected
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- JOINING SCHEDULE -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                Joining Schedule
            </h5>
        </div>

        <div class="card-body">

            @if (Model.JoiningSchedule != null)
            {
                <div class="row">

                    <!-- PROPOSED JOINING DATE -->
                    <div class="col-md-6 mb-3">

                        <label class="text-muted">
                            Joining Date Provided by HR
                        </label>

                        <div class="fw-semibold">

                            @if (Model.JoiningSchedule.SelectedJoiningDate.HasValue)
                            {
                                <span>
                                    @Model.JoiningSchedule.SelectedJoiningDate.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not provided
                                </span>
                            }

                        </div>

                    </div>


                    <!-- CONFIRMED JOINING DATE -->
                    <div class="col-md-6 mb-3">

                        <label class="text-muted">
                            Confirmed Joining Date
                        </label>

                        <div class="fw-semibold">

                            @if (Model.JoiningSchedule.ConfirmedJoiningDate.HasValue)
                            {
                                <span>
                                    @Model.JoiningSchedule.ConfirmedJoiningDate.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not confirmed
                                </span>
                            }

                        </div>

                    </div>


                    <!-- JOINING STATUS -->
                    <div class="col-md-6 mb-3">

                        <label class="text-muted">
                            Joining Status
                        </label>

                        <div>

                            @if (Model.JoiningSchedule.IsConfirmed)
                            {
                                <span class="badge bg-success">
                                    Confirmed
                                </span>
                            }
                            else if (Model.Status == RecruitmentAndCandidateScreeningSystem.Models.Enums.OfferStatus.Rejected)
                            {
                                <span class="badge bg-secondary">
                                    Not Applicable
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Awaiting Candidate Decision
                                </span>
                            }

                        </div>

                    </div>


                    <!-- CONFIRMED AT -->
                    <div class="col-md-6 mb-3">

                        <label class="text-muted">
                            Confirmed At
                        </label>

                        <div class="fw-semibold">

                            @if (Model.JoiningSchedule.ConfirmedAt.HasValue)
                            {
                                <span>
                                    @Model.JoiningSchedule.ConfirmedAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    —
                                </span>
                            }

                        </div>

                    </div>

                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    No joining schedule has been created for this offer.
                </div>
            }

        </div>

    </div>


    <!-- CANDIDATE DECISION -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                Candidate Decision
            </h5>
        </div>

        <div class="card-body">

            <div class="row">

                <!-- DECISION -->
                <div class="col-md-6 mb-3">

                    <label class="text-muted">
                        Decision
                    </label>

                    <div>

                        @if (Model.CandidateDecision == RecruitmentAndCandidateScreeningSystem.Models.Enums.CandidateDecision.Accepted)
                        {
                            <span class="badge bg-success">
                                Accepted
                            </span>
                        }
                        else if (Model.CandidateDecision == RecruitmentAndCandidateScreeningSystem.Models.Enums.CandidateDecision.Rejected)
                        {
                            <span class="badge bg-danger">
                                Rejected
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }

                    </div>

                </div>


                <!-- DECISION DATE -->
                <div class="col-md-6 mb-3">

                    <label class="text-muted">
                        Decision Date
                    </label>

                    <div class="fw-semibold">

                        @if (Model.DecisionDate.HasValue)
                        {
                            <span>
                                @Model.DecisionDate.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                —
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- BACK BUTTON -->
    <div class="mt-4 mb-5">

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Offers
        </a>

    </div>

</div>