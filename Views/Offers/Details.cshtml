@model RecruitmentAndCandidateScreeningSystem.Models.Offer

@{
    ViewData["Title"] = "Offer & Joining Schedule Review";
}

<div class="container py-4">

    <!-- Header & Navigation -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
                <i class="bi bi-arrow-left me-1"></i>Back to Offers Pipeline
            </a>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h2 class="fw-bold text-slate-900 mb-0">Employment Offer Summary</h2>
                @if (Model.Status == RecruitmentAndCandidateScreeningSystem.Models.Enums.OfferStatus.Accepted)
                {
                    <span class="status-pill status-pill-success">
                        <span class="status-dot"></span>Offer Accepted
                    </span>
                }
                else if (Model.Status == RecruitmentAndCandidateScreeningSystem.Models.Enums.OfferStatus.Rejected)
                {
                    <span class="status-pill status-pill-danger">
                        <span class="status-dot"></span>Offer Declined
                    </span>
                }
                else
                {
                    <span class="status-pill status-pill-warning">
                        <span class="status-dot"></span>Pending Response
                    </span>
                }
            </div>
            <p class="text-muted small mb-0 mt-1">Comprehensive record of offer terms, response status, and joining coordination.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-list-ul me-1"></i>All Offers
        </a>
    </div>

    <!-- Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                <div>@TempData["Success"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                <div>@TempData["Error"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Candidate Context Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="fw-bold mb-0 text-slate-900">
                <i class="bi bi-person-badge text-primary me-2"></i>Candidate &amp; Position Reference
            </h6>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem;">Candidate Name</label>
                    <div class="fw-bold text-slate-900 fs-6">
                        @(Model.JobApplication?.CandidateProfile?.FullName ?? "N/A")
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem;">Target Position</label>
                    <div class="text-slate-800 fw-medium">
                        @(Model.JobApplication?.JobCircular?.JobTitle ?? "N/A")
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem;">Application Reference</label>
                    <div>
                        <code class="fw-semibold text-slate-800">
                            @(Model.JobApplication?.ApplicationReferenceId ?? "N/A")
                        </code>
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem;">Application Status</label>
                    <div>
                        <span class="status-pill status-pill-success">
                            <span class="status-dot"></span>@(Model.JobApplication?.Status.ToString() ?? "N/A")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Offer Terms & Dates Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="fw-bold mb-0 text-slate-900">
                <i class="bi bi-file-earmark-text text-primary me-2"></i>Terms of Employment &amp; Timelines
            </h6>
        </div>
        <div class="card-body p-4">
            <div class="mb-4">
                <label class="text-muted small fw-semibold text-uppercase mb-2" style="font-size: 0.72rem;">Offer Letter Body</label>
                <div class="border rounded-3 p-4 bg-light text-slate-800 small" style="white-space: pre-line; line-height: 1.7; font-size: 0.9rem;">
                    @Model.OfferDetails
                </div>
            </div>

            <div class="row g-3 pt-3 border-top">
                <div class="col-md-4">
                    <label class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem;">Date Extended</label>
                    <div class="fw-medium text-slate-800">
                        <i class="bi bi-calendar-event me-1 text-muted"></i>@Model.OfferDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem;">Response Deadline</label>
                    <div class="fw-medium text-slate-800">
                        @if (Model.ResponseDeadline.HasValue)
                        {
                            <span><i class="bi bi-alarm me-1 text-muted"></i>@Model.ResponseDeadline.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                        }
                        else
                        {
                            <span class="text-muted small">No deadline specified</span>
                        }
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem;">Current Offer Status</label>
                    <div>
                        @if (Model.Status == RecruitmentAndCandidateScreeningSystem.Models.Enums.OfferStatus.Accepted)
                        {
                            <span class="status-pill status-pill-success">
                                <span class="status-dot"></span>Accepted
                            </span>
                        }
                        else if (Model.Status == RecruitmentAndCandidateScreeningSystem.Models.Enums.OfferStatus.Rejected)
                        {
                            <span class="status-pill status-pill-danger">
                                <span class="status-dot"></span>Rejected
                            </span>
                        }
                        else
                        {
                            <span class="status-pill status-pill-warning">
                                <span class="status-dot"></span>Pending
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Joining Schedule & Confirmation -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="fw-bold mb-0 text-slate-900">
                <i class="bi bi-calendar-check text-primary me-2"></i>Joining Schedule Coordination
            </h6>
        </div>
        <div class="card-body p-4">
            @if (Model.JoiningSchedule != null)
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem;">Proposed Joining Date (by HR)</label>
                        <div class="fw-medium text-slate-800 fs-6">
                            @if (Model.JoiningSchedule.SelectedJoiningDate.HasValue)
                            {
                                <span><i class="bi bi-calendar3 me-1 text-muted"></i>@Model.JoiningSchedule.SelectedJoiningDate.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                            }
                            else
                            {
                                <span class="text-muted small">Not provided</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem;">Confirmed Joining Date</label>
                        <div class="fw-medium text-slate-800 fs-6">
                            @if (Model.JoiningSchedule.ConfirmedJoiningDate.HasValue)
                            {
                                <span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>@Model.JoiningSchedule.ConfirmedJoiningDate.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                            }
                            else
                            {
                                <span class="text-muted small">Not yet confirmed by candidate</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem;">Joining Confirmation Status</label>
                        <div>
                            @if (Model.JoiningSchedule.IsConfirmed)
                            {
                                <span class="status-pill status-pill-success">
                                    <span class="status-dot"></span>Confirmed by Candidate
                                </span>
                            }
                            else if (Model.Status == RecruitmentAndCandidateScreeningSystem.Models.Enums.OfferStatus.Rejected)
                            {
                                <span class="status-pill status-pill-neutral">
                                    <span class="status-dot"></span>Not Applicable (Declined)
                                </span>
                            }
                            else
                            {
                                <span class="status-pill status-pill-warning">
                                    <span class="status-dot"></span>Awaiting Candidate Acceptance
                                </span>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem;">Confirmation Timestamp</label>
                        <div class="text-slate-800">
                            @if (Model.JoiningSchedule.ConfirmedAt.HasValue)
                            {
                                <span>@Model.JoiningSchedule.ConfirmedAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning border-0 rounded-3 mb-0 small">
                    <i class="bi bi-exclamation-triangle me-1"></i>No joining schedule is currently attached to this offer.
                </div>
            }
        </div>
    </div>

    <!-- Candidate Decision Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-5 bg-white">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="fw-bold mb-0 text-slate-900">
                <i class="bi bi-chat-left-quote text-primary me-2"></i>Candidate Response Audit
            </h6>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem;">Candidate Decision</label>
                    <div>
                        @if (Model.CandidateDecision == RecruitmentAndCandidateScreeningSystem.Models.Enums.CandidateDecision.Accepted)
                        {
                            <span class="status-pill status-pill-success fs-6 px-3 py-1">
                                <span class="status-dot"></span>Accepted &check;
                            </span>
                        }
                        else if (Model.CandidateDecision == RecruitmentAndCandidateScreeningSystem.Models.Enums.CandidateDecision.Rejected)
                        {
                            <span class="status-pill status-pill-danger fs-6 px-3 py-1">
                                <span class="status-dot"></span>Declined
                            </span>
                        }
                        else
                        {
                            <span class="status-pill status-pill-warning fs-6 px-3 py-1">
                                <span class="status-dot"></span>Decision Pending
                            </span>
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem;">Decision Timestamp</label>
                    <div class="fw-medium text-slate-800">
                        @if (Model.DecisionDate.HasValue)
                        {
                            <span>@Model.DecisionDate.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                        }
                        else
                        {
                            <span class="text-muted small">Awaiting candidate action</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>