@using RecruitmentAndCandidateScreeningSystem.Models.Enums
@model IEnumerable<RecruitmentAndCandidateScreeningSystem.ViewModels.HRApplicationViewModel>

@{
    ViewData["Title"] = "Applications";

    var search = ViewBag.Search as string;
    var selectedStatus = ViewBag.Status as string;
}

<div class="container">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-bold">Job Applications</h2>

        <p class="text-muted">
            Review candidate applications, payments, and AI screening results.
        </p>
    </div>


    <!-- Search and Filters -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3 align-items-end">

                    <!-- Search -->
                    <div class="col-md-5">

                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <input type="text"
                               name="search"
                               value="@search"
                               class="form-control"
                               placeholder="Candidate name, email or job title..." />

                    </div>


                    <!-- Application Status -->
                    <div class="col-md-3">

                        <label class="form-label fw-semibold">
                            Application Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                All Applications
                            </option>

                            @foreach (var item in Enum.GetValues<JobApplicationStatus>())
                            {
                                if (selectedStatus == item.ToString())
                                {
                                    <option value="@item" selected>
                                        @item
                                    </option>
                                }
                                else
                                {
                                    <option value="@item">
                                        @item
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- AI Decision -->
                    <div class="col-md-2">

                        <label class="form-label fw-semibold">
                            AI Decision
                        </label>

                        <select id="aiDecisionFilter"
                                class="form-select">

                            <option value="">
                                All
                            </option>

                            <option value="SHORTLISTED">
                                Shortlisted
                            </option>

                            <option value="MANUAL REVIEW">
                                Manual Review
                            </option>

                            <option value="REJECTED">
                                Rejected
                            </option>

                            <option value="NOT_EVALUATED">
                                Not Evaluated
                            </option>

                        </select>

                    </div>


                    <!-- Buttons -->
                    <div class="col-md-2 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-grow-1">
                            Search
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Clear
                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Applications -->
    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No applications found.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">

            <div class="table-responsive">

                <table id="applicationsTable"
                       class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Candidate
                            </th>

                            <th>
                                Job
                            </th>

                            <th>
                                Applied
                            </th>

                            <th>
                                AI Score
                            </th>

                            <th>
                                AI Decision
                            </th>

                            <th>
                                Payment
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Reference
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var application in Model)
                        {
                            var aiDecision =
                                application.AIDecision
                                ?? "NOT_EVALUATED";

                            <tr data-ai-decision="@aiDecision">

                                <!-- Candidate -->
                                <td>

                                    <strong>
                                        @application.CandidateName
                                    </strong>

                                    <br />

                                    <small class="text-muted">
                                        @application.CandidateEmail
                                    </small>

                                </td>


                                <!-- Job -->
                                <td>
                                    @application.JobTitle
                                </td>


                                <!-- Applied -->
                                <td>
                                    @application.AppliedAt
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy")
                                </td>


                                <!-- AI Score -->
                                <td>

                                    @if (application.AIMatchingScore.HasValue)
                                    {
                                        <strong>
                                            @application.AIMatchingScore.Value.ToString("0.##")%
                                        </strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- AI Decision -->
                                <td>

                                    @if (application.AIDecision == "SHORTLISTED")
                                    {
                                        <span class="badge bg-success">
                                            SHORTLISTED
                                        </span>
                                    }
                                    else if (application.AIDecision == "MANUAL REVIEW")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            MANUAL REVIEW
                                        </span>
                                    }
                                    else if (application.AIDecision == "REJECTED")
                                    {
                                        <span class="badge bg-danger">
                                            REJECTED
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Not Evaluated
                                        </span>
                                    }

                                </td>


                                <!-- Payment -->
                                <td>

                                    @if (application.PaymentStatus == "Paid")
                                    {
                                        <span class="badge bg-success">
                                            Paid
                                        </span>
                                    }
                                    else if (application.PaymentStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Not Required
                                        </span>
                                    }

                                </td>


                                <!-- Application Status -->
                                <td>
                                    @if (application.ApplicationStatus == "Shortlisted")
                                    {
                                        <span class="badge bg-success">
                                            Shortlisted
                                        </span>
                                    }
                                    else if (application.ApplicationStatus == "ManualReview")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Manual Review
                                        </span>
                                    }
                                    else if (application.ApplicationStatus == "Rejected")
                                    {
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                    }
                                    else if (application.ApplicationStatus == "Payment Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Payment Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @application.ApplicationStatus
                                        </span>
                                    }
                                </td>


                                <!-- Reference -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        application.ApplicationReferenceId))
                                    {
                                        <span>
                                            @application.ApplicationReferenceId
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- Action -->
                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@application.Id"
                                       class="btn btn-sm btn-primary">
                                        View
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>


@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const filter =
                document.getElementById("aiDecisionFilter");

            const rows =
                document.querySelectorAll(
                    "#applicationsTable tbody tr");

            filter.addEventListener("change", function () {

                const selected =
                    this.value;

                rows.forEach(function (row) {

                    const decision =
                        row.getAttribute(
                            "data-ai-decision");

                    if (
                        selected === "" ||
                        decision === selected
                    ) {
                        row.style.display = "";
                    }
                    else {
                        row.style.display = "none";
                    }

                });

            });

        });
    </script>
}