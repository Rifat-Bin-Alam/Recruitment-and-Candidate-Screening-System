@using RecruitmentAndCandidateScreeningSystem.Models.Enums
@model IEnumerable<RecruitmentAndCandidateScreeningSystem.ViewModels.HRApplicationViewModel>

@{
    ViewData["Title"] = "Applications";

    var search = ViewBag.Search as string;
    var selectedStatus = ViewBag.Status as string;
}

<div class="container">

    <div class="mb-4">
        <h2 class="fw-bold">Job Applications</h2>

        <p class="text-muted">
            Review candidate applications and their payment status.
        </p>
    </div>

    <!-- Search and Filter -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <input type="text"
                               name="search"
                               value="@search"
                               class="form-control"
                               placeholder="Candidate name, email or job title..." />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Application Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                All Applications
                            </option>

                            @foreach (var item in Enum.GetValues<JobApplicationStatus>())
                            {
                                <option value="@item"
                                        selected="@(selectedStatus == item.ToString())">
                                    @item
                                </option>
                            }

                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-grow-1">
                            Search
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Clear
                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- Applications -->
    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No applications found.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Candidate</th>
                            <th>Job</th>
                            <th>Applied</th>
                            <th>Payment</th>
                            <th>Status</th>
                            <th>Reference</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var application in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @application.CandidateName
                                    </strong>

                                    <br />

                                    <small class="text-muted">
                                        @application.CandidateEmail
                                    </small>
                                </td>

                                <td>
                                    @application.JobTitle
                                </td>

                                <td>
                                    @application.AppliedAt
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @if (application.PaymentStatus == "Paid")
                                    {
                                        <span class="badge bg-success">
                                            Paid
                                        </span>
                                    }
                                    else if (application.PaymentStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Not Required
                                        </span>
                                    }
                                </td>

                                <td>
                                    @application.ApplicationStatus
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(
                                        application.ApplicationReferenceId))
                                    {
                                        <span>
                                            @application.ApplicationReferenceId
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }
                                </td>

                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@application.Id"
                                       class="btn btn-sm btn-primary">
                                        View
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>