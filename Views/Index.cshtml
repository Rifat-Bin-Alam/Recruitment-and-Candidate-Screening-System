@model IEnumerable<RecruitmentAndCandidateScreeningSystem.Models.JobCircular>

@{
    ViewData["Title"] = "Job Circulars";
}

<div class="container-fluid px-0">

    <!-- PAGE HEADER -->
    <div class="page-header mb-4">
        <div>
            <h2 class="page-title">Job Circulars</h2>
            <p class="page-subtitle">
                Create, manage and monitor your organization's job circulars.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary px-4">
            <span class="me-1">+</span>
            Create Job Circular
        </a>
    </div>


    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            <strong>Unable to complete the action.</strong>
            <br />

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- JOB CIRCULAR CARD -->
    <div class="card border-0 shadow-sm dashboard-table-card">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-bold mb-1">
                        All Job Circulars
                    </h5>

                    <p class="text-muted mb-0 small">
                        Manage published, draft and closed positions.
                    </p>
                </div>

                <span class="badge bg-light text-dark border px-3 py-2">
                    @Model.Count() Position(s)
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <!-- EMPTY STATE -->

                <div class="text-center py-5 px-4">

                    <div class="empty-state-icon mb-3">
                        📋
                    </div>

                    <h5 class="fw-bold">
                        No Job Circulars Yet
                    </h5>

                    <p class="text-muted mb-4">
                        Create your first job circular to start recruiting candidates.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary px-4">
                        Create Job Circular
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Job Title
                                </th>

                                <th>
                                    Department
                                </th>

                                <th>
                                    Location
                                </th>

                                <th>
                                    Deadline
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end pe-4">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var job in Model)
                            {
                                <tr>

                                    <!-- JOB TITLE -->
                                    <td class="ps-4">

                                        <div class="fw-semibold">
                                            @job.JobTitle
                                        </div>

                                        <small class="text-muted">
                                            Job ID: #@job.Id
                                        </small>

                                    </td>


                                    <!-- DEPARTMENT -->
                                    <td>
                                        @job.Department
                                    </td>


                                    <!-- LOCATION -->
                                    <td>
                                        @job.Location
                                    </td>


                                    <!-- DEADLINE -->
                                    <td>

                                        <span>
                                            @job.ApplicationDeadline
                                            .ToLocalTime()
                                            .ToString("dd MMM yyyy, hh:mm tt")
                                        </span>

                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        @if (job.Status ==
                                            RecruitmentAndCandidateScreeningSystem.Models.Enums.JobCircularStatus.Draft)
                                        {
                                            <span class="badge status-badge status-draft">
                                                Draft
                                            </span>
                                        }
                                        else if (job.Status ==
                                            RecruitmentAndCandidateScreeningSystem.Models.Enums.JobCircularStatus.Published)
                                        {
                                            <span class="badge status-badge status-published">
                                                Published
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge status-badge status-closed">
                                                Closed
                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->
                                    <td class="text-end pe-4">

                                        <div class="d-flex justify-content-end flex-wrap gap-1">

                                            <!-- DETAILS -->
                                            <a asp-action="Details"
                                               asp-route-id="@job.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Details
                                            </a>


                                            <!-- EDIT -->
                                            <a asp-action="Edit"
                                               asp-route-id="@job.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                                Edit
                                            </a>


                                            <!-- PUBLISH -->
                                            @if (job.Status ==
                                                RecruitmentAndCandidateScreeningSystem.Models.Enums.JobCircularStatus.Draft)
                                            {
                                                <form asp-action="Publish"
                                                      asp-route-id="@job.Id"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            onclick="return confirm('Are you sure you want to publish this job circular?');">
                                                        Publish
                                                    </button>

                                                </form>
                                            }


                                            <!-- CLOSE -->
                                            @if (job.Status ==
                                                RecruitmentAndCandidateScreeningSystem.Models.Enums.JobCircularStatus.Published)
                                            {
                                                <form asp-action="Close"
                                                      asp-route-id="@job.Id"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Are you sure you want to close this job circular?');">
                                                        Close
                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>