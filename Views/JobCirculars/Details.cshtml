@model RecruitmentAndCandidateScreeningSystem.Models.JobCircular

@{
    ViewData["Title"] = "Job Details";
}

<h2 class="mb-4">@Model.JobTitle</h2>

<div class="card">
    <div class="card-body">

        <p>
            <strong>Department:</strong>
            @Model.Department
        </p>

        <p>
            <strong>Location:</strong>
            @Model.Location
        </p>

        <p>
            <strong>Application Fee:</strong>
            @(Model.ApplicationFee?.ToString("0.00") ?? "Free")
        </p>

        <p>
            <strong>Deadline:</strong>
            @Model.ApplicationDeadline.ToLocalTime()
        </p>

        <p>
            <strong>Status:</strong>
            @Model.Status
        </p>

        <hr />

        <h5>Description</h5>
        <p>@Model.JobDescription</p>

        <hr />

        <h5>Job Requirements</h5>

        <form asp-action="SaveRequirements" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="jobCircularId"
                   value="@Model.Id" />

            <div class="mb-3">
                <label class="form-label">Required Qualifications</label>
                <textarea name="requiredQualifications"
                          class="form-control"
                          rows="3">@Model.JobRequirement?.RequiredQualifications</textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Required Skills</label>
                <textarea name="requiredSkills"
                          class="form-control"
                          rows="3">@Model.JobRequirement?.RequiredSkills</textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Required Experience</label>
                <textarea name="requiredExperience"
                          class="form-control"
                          rows="3">@Model.JobRequirement?.RequiredExperience</textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Additional Requirements</label>
                <textarea name="additionalRequirements"
                          class="form-control"
                          rows="3">@Model.JobRequirement?.AdditionalRequirements</textarea>
            </div>

            <button type="submit" class="btn btn-primary">
                Save Requirements
            </button>

        </form>

    </div>
</div>

<div class="mt-3">

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Edit Job
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</div>