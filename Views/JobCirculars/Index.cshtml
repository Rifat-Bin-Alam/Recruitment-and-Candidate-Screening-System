@model IEnumerable<RecruitmentAndCandidateScreeningSystem.Models.JobCircular>

@{
    ViewData["Title"] = "Job Circulars Management";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small">
                    <i class="bi bi-briefcase me-1"></i>Requisitions
                </span>
            </div>
            <h2 class="fw-bold text-slate-900 mb-1">Job Circulars</h2>
            <p class="text-muted mb-0 small">
                Configure job positions, requirements, publication status, and application windows.
            </p>
        </div>

        <div>
            <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i>Create Job Circular
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                <div>@TempData["Error"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                <div>@TempData["Success"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 p-5 text-center bg-white">
            <div class="text-slate-400 mb-3">
                <i class="bi bi-folder2-open display-4"></i>
            </div>
            <h5 class="fw-bold text-slate-800">No Job Circulars Created</h5>
            <p class="text-muted small mb-3">Get started by creating your first job circular requisition.</p>
            <div>
                <a asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i>Create Circular
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-responsive">
                <table class="table-saas">
                    <thead>
                        <tr>
                            <th class="ps-3 py-3">Position Title</th>
                            <th class="py-3">Department</th>
                            <th class="py-3">Location</th>
                            <th class="py-3">Deadline</th>
                            <th class="py-3">Status</th>
                            <th class="text-end pe-3 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-slate-900">@job.JobTitle</div>
                                    <div class="small text-muted">
                                        Fee: @(job.ApplicationFee.HasValue && job.ApplicationFee.Value > 0 ? $"${job.ApplicationFee.Value:F2} USD" : "Free")
                                    </div>
                                </td>
                                <td>
                                    <span class="text-slate-800">@(string.IsNullOrWhiteSpace(job.Department) ? "General" : job.Department)</span>
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        <i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrWhiteSpace(job.Location) ? "Not specified" : job.Location)
                                    </span>
                                </td>
                                <td>
                                    <div class="small fw-medium text-slate-800">
                                        @job.ApplicationDeadline.ToLocalTime().ToString("dd MMM yyyy")
                                    </div>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        @job.ApplicationDeadline.ToLocalTime().ToString("hh:mm tt")
                                    </div>
                                </td>
                                <td>
                                    @if (job.Status == RecruitmentAndCandidateScreeningSystem.Models.Enums.JobCircularStatus.Published)
                                    {
                                        <span class="status-pill status-pill-success">
                                            <span class="status-dot"></span>Published
                                        </span>
                                    }
                                    else if (job.Status == RecruitmentAndCandidateScreeningSystem.Models.Enums.JobCircularStatus.Draft)
                                    {
                                        <span class="status-pill status-pill-neutral">
                                            <span class="status-dot"></span>Draft
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-pill-danger">
                                            <span class="status-dot"></span>Closed
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-sm btn-outline-secondary" title="View Requirements &amp; Details">
                                            <i class="bi bi-eye"></i> Details
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-sm btn-outline-primary" title="Edit Requisition">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>

                                        @if (job.Status == RecruitmentAndCandidateScreeningSystem.Models.Enums.JobCircularStatus.Draft)
                                        {
                                            <form asp-action="Publish" asp-route-id="@job.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success px-2" title="Publish to live candidates">
                                                    <i class="bi bi-send me-1"></i>Publish
                                                </button>
                                            </form>
                                        }

                                        @if (job.Status == RecruitmentAndCandidateScreeningSystem.Models.Enums.JobCircularStatus.Published)
                                        {
                                            <form asp-action="Close" asp-route-id="@job.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger px-2" title="Close applications for this job" onclick="return confirm('Are you sure you want to close this job circular? Candidates will no longer be able to apply.');">
                                                    <i class="bi bi-x-circle me-1"></i>Close
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>