@model IEnumerable<RecruitmentAndCandidateScreeningSystem.Models.JobCircular>

@{
    ViewData["Title"] = "Job Circulars";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Job Circulars</h2>

    <a asp-action="Create" class="btn btn-primary">
        Create Job Circular
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        No job circulars have been created yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>Job Title</th>
                    <th>Department</th>
                    <th>Location</th>
                    <th>Deadline</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var job in Model)
                {
                    <tr>
                        <td>@job.JobTitle</td>
                        <td>@job.Department</td>
                        <td>@job.Location</td>
                        <td>@job.ApplicationDeadline.ToLocalTime()</td>
                        <td>@job.Status</td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@job.Id"
                               class="btn btn-sm btn-info">
                                Details
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@job.Id"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>

                            @if (job.Status == RecruitmentAndCandidateScreeningSystem.Models.Enums.JobCircularStatus.Draft)
                            {
                                <form asp-action="Publish"
                                      asp-route-id="@job.Id"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success">
                                        Publish
                                    </button>
                                </form>
                            }

                            @if (job.Status == RecruitmentAndCandidateScreeningSystem.Models.Enums.JobCircularStatus.Published)
                            {
                                <form asp-action="Close"
                                      asp-route-id="@job.Id"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        Close
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}