@model RecruitmentAndCandidateScreeningSystem.Models.JobCircular

@{
    ViewData["Title"] = "Create Job Circular";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">

            <!-- Breadcrumb / Header -->
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
                        <i class="bi bi-arrow-left me-1"></i>Back to Circulars
                    </a>
                    <h2 class="fw-bold text-slate-900 mb-1">Create Job Circular</h2>
                    <p class="text-muted small mb-0">Define position parameters and schedule. You will configure qualification criteria and scoring weights in the next step.</p>
                </div>
            </div>

            <!-- Workflow Help Banner -->
            <div class="alert alert-light border shadow-xs rounded-3 p-3 mb-4 small text-muted">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-lightbulb text-warning fs-5 flex-shrink-0"></i>
                    <div>
                        <strong class="text-slate-800">Draft Status by Default:</strong> New circulars are saved as private drafts so you can review screening benchmarks before publishing to candidates.
                    </div>
                </div>
            </div>

            <!-- Main Form Card -->
            <div class="card border-0 shadow-sm rounded-3 bg-white">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <h6 class="fw-bold mb-0 text-slate-900">
                            <i class="bi bi-file-earmark-plus text-primary me-2"></i>Position Specification
                        </h6>
                        <span class="badge-requisition"><i class="bi bi-file-earmark-text text-primary me-1"></i>Requisition Form</span>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="createCircularForm">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-3 mb-4 rounded-3" role="alert"></div>

                        <partial name="_Form" model="Model" />

                        <div class="d-flex flex-column flex-sm-row align-items-center justify-content-end gap-2 pt-3 border-top mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary px-3 w-100 w-sm-auto order-2 order-sm-1">
                                <i class="bi bi-x-circle me-1"></i>Cancel &amp; Return
                            </a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm w-100 w-sm-auto order-1 order-sm-2">
                                <i class="bi bi-check2-circle me-1"></i>Save Draft &amp; Continue
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
