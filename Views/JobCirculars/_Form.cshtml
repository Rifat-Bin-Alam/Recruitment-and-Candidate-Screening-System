@model RecruitmentAndCandidateScreeningSystem.Models.JobCircular

<div class="mb-3">
    <label asp-for="JobTitle" class="form-label"></label>
    <input asp-for="JobTitle" class="form-control" />
    <span asp-validation-for="JobTitle" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="JobDescription" class="form-label"></label>
    <textarea asp-for="JobDescription" class="form-control" rows="5"></textarea>
    <span asp-validation-for="JobDescription" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Department" class="form-label"></label>
    <input asp-for="Department" class="form-control" />
</div>

<div class="mb-3">
    <label asp-for="Location" class="form-label"></label>
    <input asp-for="Location" class="form-control" />
</div>

<div class="mb-3">
    <label asp-for="ApplicationFee" class="form-label"></label>
    <input asp-for="ApplicationFee" type="number" step="0.01" class="form-control" />
</div>

<div class="mb-3">
    <label asp-for="ApplicationDeadline" class="form-label"></label>
    <input asp-for="ApplicationDeadline" type="datetime-local" class="form-control" />
    <span asp-validation-for="ApplicationDeadline" class="text-danger"></span>
</div>