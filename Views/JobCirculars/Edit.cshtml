@model RecruitmentAndCandidateScreeningSystem.Models.JobCircular

@{
    ViewData["Title"] = "Edit Job Circular";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">

            <!-- Breadcrumb / Header -->
            <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
                        <i class="bi bi-arrow-left me-1"></i>Back to Circulars
                    </a>
                    <h2 class="fw-bold text-slate-900 mb-1">Edit Job Circular</h2>
                    <p class="text-muted small mb-0">Modify specifications, application fee, or deadline for this position.</p>
                </div>

                <div>
                    @if (Model.Status == RecruitmentAndCandidateScreeningSystem.Models.Enums.JobCircularStatus.Published)
                    {
                        <span class="status-pill status-pill-success">
                            <span class="status-dot"></span>Published
                        </span>
                    }
                    else if (Model.Status == RecruitmentAndCandidateScreeningSystem.Models.Enums.JobCircularStatus.Draft)
                    {
                        <span class="status-pill status-pill-neutral">
                            <span class="status-dot"></span>Draft
                        </span>
                    }
                    else
                    {
                        <span class="status-pill status-pill-danger">
                            <span class="status-dot"></span>Closed
                        </span>
                    }
                </div>
            </div>

            <!-- Main Edit Form Card -->
            <div class="card border-0 shadow-sm rounded-3 bg-white">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <h6 class="fw-bold mb-0 text-slate-900">
                            <i class="bi bi-pencil-square text-primary me-2"></i>Edit Position Details
                        </h6>
                        <span class="badge-requisition"><i class="bi bi-hash text-primary me-0.5"></i>Requisition #@Model.Id</span>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" id="editCircularForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-3 mb-4 rounded-3" role="alert"></div>

                        <partial name="_Form" model="Model" />

                        <div class="d-flex flex-column flex-sm-row align-items-center justify-content-end gap-2 pt-3 border-top mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary px-3 w-100 w-sm-auto order-2 order-sm-1">
                                <i class="bi bi-x-circle me-1"></i>Cancel &amp; Return
                            </a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm w-100 w-sm-auto order-1 order-sm-2">
                                <i class="bi bi-check2-circle me-1"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
