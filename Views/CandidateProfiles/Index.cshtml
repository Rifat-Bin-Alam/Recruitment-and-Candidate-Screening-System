@model RecruitmentAndCandidateScreeningSystem.ViewModels.CandidateProfileViewModel

@{
    ViewData["Title"] = "Candidate Profile & Documents";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <div class="d-inline-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small">
                    <i class="bi bi-person-badge me-1"></i>Candidate Profile
                </span>
                <span class="text-muted small">&bull; Credential Management</span>
            </div>
            <h2 class="fw-bold text-slate-900 mb-1">My Profile &amp; Document Vault</h2>
            <p class="text-muted small mb-0">Manage your personal information, qualifications, and secure documents for applications.</p>
        </div>

        <div>
            <a asp-controller="Candidate"
               asp-action="Dashboard"
               class="btn btn-outline-secondary btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main Profile Form -->
    <form asp-action="Index"
          method="post"
          enctype="multipart/form-data"
          id="profileForm">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-3 mb-4 rounded-3"></div>

        <div class="row g-4">

            <!-- LEFT COLUMN: Personal Info & Qualifications -->
            <div class="col-lg-7">

                <!-- 1. Personal & Contact Information -->
                <div class="card border-0 shadow-sm mb-4 rounded-3 bg-white">
                    <div class="card-header bg-white border-bottom py-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-light border text-slate-700">01</span>
                            <h6 class="fw-bold mb-0 text-slate-900">Personal &amp; Contact Information</h6>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="FullName" class="form-label">Full Legal Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                                    <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" required />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="NationalId" class="form-label">National ID / Passport</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-card-text"></i></span>
                                    <input asp-for="NationalId" class="form-control" placeholder="e.g. NID-123456789" />
                                </div>
                                <span asp-validation-for="NationalId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label">Contact Telephone</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="e.g. +880 1712 345678" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Address" class="form-label">Residential Address</label>
                                <textarea asp-for="Address" class="form-control" rows="2" placeholder="Street address, city, postal code"></textarea>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Academic Background -->
                <div class="card border-0 shadow-sm mb-4 rounded-3 bg-white">
                    <div class="card-header bg-white border-bottom py-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-light border text-slate-700">02</span>
                            <h6 class="fw-bold mb-0 text-slate-900">Academic Qualifications</h6>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="HighestQualification" class="form-label">Highest Degree / Certification</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-mortarboard"></i></span>
                                <input asp-for="HighestQualification" class="form-control" placeholder="e.g. B.Sc. in Computer Science & Engineering" />
                            </div>
                            <span asp-validation-for="HighestQualification" class="text-danger small"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="EducationDetails" class="form-label">Educational Institutions &amp; Year of Completion</label>
                            <textarea asp-for="EducationDetails" class="form-control" rows="3" placeholder="Summarize your university, college, degrees, majors, and passing years..."></textarea>
                            <span asp-validation-for="EducationDetails" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- 3. Professional Background & Skills -->
                <div class="card border-0 shadow-sm mb-4 rounded-3 bg-white">
                    <div class="card-header bg-white border-bottom py-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-light border text-slate-700">03</span>
                            <h6 class="fw-bold mb-0 text-slate-900">Professional Experience &amp; Skills</h6>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="ExperienceDetails" class="form-label">Employment &amp; Professional History</label>
                            <textarea asp-for="ExperienceDetails" class="form-control" rows="3" placeholder="Outline your previous job roles, companies, responsibilities, and total years of experience..."></textarea>
                            <span asp-validation-for="ExperienceDetails" class="text-danger small"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Skills" class="form-label">Key Competencies &amp; Technologies</label>
                            <textarea asp-for="Skills" class="form-control" rows="3" placeholder="List relevant skills separated by commas, e.g. C#, ASP.NET Core, SQL Server, Python, Project Management"></textarea>
                            <span asp-validation-for="Skills" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- RIGHT COLUMN: Secure Document Assets (Photo, Signature, CV) -->
            <div class="col-lg-5">

                <!-- Upload Size Policy Notice -->
                <div class="alert alert-light border shadow-xs rounded-3 p-3 mb-4 small text-muted">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle text-primary fs-6 flex-shrink-0"></i>
                        <span>To keep the system responsive within our available server storage and memory limits, uploads are restricted to the sizes shown.</span>
                    </div>
                </div>

                <!-- 4. Profile Photo & Signature -->
                <div class="card border-0 shadow-sm mb-4 rounded-3 bg-white">
                    <div class="card-header bg-white border-bottom py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-light border text-slate-700">04</span>
                                <h6 class="fw-bold mb-0 text-slate-900">Identity Assets</h6>
                            </div>
                            <span class="size-limit-badge">Max 50 KB Each</span>
                        </div>
                    </div>
                    <div class="card-body p-4">

                        <!-- Photo Section -->
                        <div class="mb-4 pb-4 border-bottom">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label asp-for="Photo" class="form-label fw-bold mb-0">Candidate Photo</label>
                                <span class="badge bg-light border text-slate-600" style="font-size: 0.72rem;">50 KB Limit</span>
                            </div>

                            <div class="text-center mb-3">
                                <div class="preview-box mx-auto p-1" style="width: 140px; height: 160px;">
                                    <img src="@Url.Action("Photo", "CandidateProfiles", new { v = DateTime.UtcNow.Ticks })"
                                         alt="Profile Photo"
                                         class="w-100 h-100 rounded"
                                         style="object-fit: cover;"
                                         onerror="this.parentElement.innerHTML='<span class=\'text-muted small\'>No Photo Uploaded</span>';" />
                                </div>
                            </div>

                            <input asp-for="Photo"
                                   type="file"
                                   id="candidatePhotoInput"
                                   class="form-control form-control-sm"
                                   accept=".jpg,.jpeg,.png" />
                            <div class="form-text">Accepted: JPG, JPEG or PNG &mdash; maximum 50 KB.</div>
                            <div id="photoSizeAlert" class="text-danger small mt-1" style="display: none;"></div>
                            <span asp-validation-for="Photo" class="text-danger small"></span>
                        </div>

                        <!-- Signature Section -->
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label asp-for="Signature" class="form-label fw-bold mb-0">Official Signature</label>
                                <span class="badge bg-light border text-slate-600" style="font-size: 0.72rem;">50 KB Limit</span>
                            </div>

                            <div class="text-center mb-3">
                                <div class="preview-box p-2 mx-auto" style="width: 100%; max-width: 260px; height: 100px;">
                                    <img src="@Url.Action("Signature", "CandidateProfiles", new { v = DateTime.UtcNow.Ticks })"
                                         alt="Signature"
                                         class="img-fluid"
                                         style="max-height: 80px; object-fit: contain;"
                                         onerror="this.parentElement.innerHTML='<span class=\'text-muted small\'>No Signature Uploaded</span>';" />
                                </div>
                            </div>

                            <input asp-for="Signature"
                                   type="file"
                                   id="candidateSignatureInput"
                                   class="form-control form-control-sm"
                                   accept=".jpg,.jpeg,.png" />
                            <div class="form-text">Accepted: JPG, JPEG or PNG &mdash; maximum 50 KB.</div>
                            <div id="signatureSizeAlert" class="text-danger small mt-1" style="display: none;"></div>
                            <span asp-validation-for="Signature" class="text-danger small"></span>
                        </div>

                    </div>
                </div>

                <!-- 5. Curriculum Vitae (CV) Section -->
                <div class="card border-0 shadow-sm mb-4 rounded-3 bg-white">
                    <div class="card-header bg-white border-bottom py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-light border text-slate-700">05</span>
                                <h6 class="fw-bold mb-0 text-slate-900">Curriculum Vitae (CV)</h6>
                            </div>
                            <span class="size-limit-badge">Max 400 KB</span>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <label asp-for="CV" class="form-label fw-bold mb-1">Upload New Current CV</label>
                        
                        <div class="p-3 bg-light rounded-3 border mb-3 small text-muted">
                            <i class="bi bi-info-circle text-primary me-1"></i>
                            Uploading a new document will register it as your current active CV for upcoming job applications and AI screening.
                        </div>

                        <input asp-for="CV"
                               type="file"
                               id="candidateCVInput"
                               class="form-control"
                               accept=".pdf,.docx" />
                        <div class="form-text">Accepted: PDF or DOCX &mdash; maximum 400 KB.</div>
                        <div id="cvSizeAlert" class="text-danger small mt-1" style="display: none;"></div>
                        <span asp-validation-for="CV" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Save & Action Controls -->
                <div class="card border-0 shadow-sm p-4 bg-white sticky-sidebar-lg rounded-3">
                    <button type="submit" class="btn btn-primary w-100 py-2.5 fw-semibold mb-2 shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i>Save Profile &amp; Documents
                    </button>
                    <a asp-controller="Candidate" asp-action="Dashboard" class="btn btn-outline-secondary w-100 btn-sm">
                        Cancel &amp; Return
                    </a>
                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            // Client-side instant size verification
            const MAX_PHOTO_BYTES = 50 * 1024;       // 50 KB
            const MAX_SIGNATURE_BYTES = 50 * 1024;   // 50 KB
            const MAX_CV_BYTES = 400 * 1024;       // 400 KB

            function checkFileSize(inputEl, alertEl, maxBytes, friendlyName) {
                if (!inputEl || !alertEl) return;
                inputEl.addEventListener('change', function () {
                    alertEl.style.display = 'none';
                    alertEl.textContent = '';
                    if (this.files && this.files[0]) {
                        const file = this.files[0];
                        if (file.size > maxBytes) {
                            alertEl.textContent = `Selected file exceeds the maximum allowed limit of ${friendlyName}. Please choose a smaller file.`;
                            alertEl.style.display = 'block';
                        }
                    }
                });
            }

            checkFileSize(
                document.getElementById('candidatePhotoInput'),
                document.getElementById('photoSizeAlert'),
                MAX_PHOTO_BYTES,
                '50 KB'
            );

            checkFileSize(
                document.getElementById('candidateSignatureInput'),
                document.getElementById('signatureSizeAlert'),
                MAX_SIGNATURE_BYTES,
                '50 KB'
            );

            checkFileSize(
                document.getElementById('candidateCVInput'),
                document.getElementById('cvSizeAlert'),
                MAX_CV_BYTES,
                '400 KB'
            );
        })();
    </script>
}