@model IEnumerable<RecruitmentAndCandidateScreeningSystem.Models.Offer>

@{
    ViewData["Title"] = "My Offers";
}

<div class="container">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-bold">My Offers</h2>

        <p class="text-muted mb-0">
            View and respond to employment offers.
        </p>
    </div>


    <!-- Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <!-- Offers -->
    <div class="card shadow-sm border-0">

        <div class="card-header">
            <h5 class="mb-0">
                Employment Offers
            </h5>
        </div>

        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Job</th>
                                <th>Offer Date</th>
                                <th>Response Deadline</th>
                                <th>Status</th>
                                <th>Decision</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var offer in Model)
                            {
                                <tr>

                                    <td>
                                        <span class="fw-semibold">
                                            @offer.JobApplication?.JobCircular?.JobTitle
                                        </span>
                                    </td>

                                    <td>
                                        @offer.OfferDate
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @if (offer.ResponseDeadline.HasValue)
                                        {
                                            @(offer.ResponseDeadline.Value
                                                .ToLocalTime()
                                                .ToString("dd MMM yyyy hh:mm tt"))
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No deadline
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No deadline
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (offer.Status ==
                                            RecruitmentAndCandidateScreeningSystem.Models.Enums.OfferStatus.Accepted)
                                        {
                                            <span class="badge bg-success">
                                                Accepted
                                            </span>
                                        }
                                        else if (offer.Status ==
                                            RecruitmentAndCandidateScreeningSystem.Models.Enums.OfferStatus.Rejected)
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (offer.CandidateDecision ==
                                            RecruitmentAndCandidateScreeningSystem.Models.Enums.CandidateDecision.Accepted)
                                        {
                                            <span class="badge bg-success">
                                                Accepted
                                            </span>
                                        }
                                        else if (offer.CandidateDecision ==
                                            RecruitmentAndCandidateScreeningSystem.Models.Enums.CandidateDecision.Rejected)
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Pending
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-action="Details"
                                           asp-route-id="@offer.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            View Offer
                                        </a>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    You do not have any offers yet.
                </div>
            }

        </div>

    </div>

</div>